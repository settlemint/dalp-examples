# The DALP API base, with no trailing /api.
DALP_URL=https://your-dalp.example.com

# The organization every call is scoped to.
DALP_ORG_ID=00000000-0000-0000-0000-000000000000

# One API key per service account. Each key carries its own roles, so the key
# a script builds its client with is what decides whether the call is allowed.
# svc-operator     identityManager, complianceManager   flows 02, 03
DALP_OPERATOR_KEY=sm_dalp_...
# svc-issuer       tokenManager                         flows 04, 05
DALP_ISSUER_KEY=sm_dalp_...
# svc-kyc          claimIssuer, a registered trusted issuer for KYC and AML
DALP_KYC_KEY=sm_dalp_...
# svc-settlement   supplyManagement, emergency          flows 08, 09
DALP_SETTLEMENT_KEY=sm_dalp_...
# svc-reporting    auditor, read-only                   flows 01, 06, 07, 09
DALP_REPORTING_KEY=sm_dalp_...

# Which wallet signs the chain writes: leave empty to let the platform choose,
# or set eoa when the service account's smart wallet is not deployed yet.
DALP_EXECUTOR=
