{
  "name": "@dalp-examples/theme",
  "version": "0.1.0",
  "private": true,
  "description": "Shared SettleMint theme tokens and Tailwind preset for DALP example apps.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./src/tailwind.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tailwind.css": "./src/tailwind.css"
  },
  "scripts": {
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings src",
    "typecheck": "tsgo --noEmit",
    "clean": "rm -rf .turbo .tsbuildinfo"
  },
  "devDependencies": {
    "@dalp-examples/tsconfig": "workspace:*",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}
