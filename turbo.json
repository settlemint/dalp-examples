{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DALP_API_URL", "DALP_API_KEY", "DALP_ORG_ID"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    }
  }
}
