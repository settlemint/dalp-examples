{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd ../.. && bun install --frozen-lockfile && bun run --filter @dalp-examples/hello build",
  "outputDirectory": "dist",
  "installCommand": "echo 'install handled by buildCommand'",
  "env": {
    "VITE_DALP_API_URL": "@vite_dalp_api_url",
    "VITE_DALP_API_KEY": "@vite_dalp_api_key"
  }
}
