{
  "name": "@dalp-examples/hello",
  "version": "0.1.0",
  "private": true,
  "description": "DALP Hello — the smallest working TanStack Start app that talks to DALP.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port ${PORT:-3000}",
    "build": "tsr generate && vite build",
    "start": "node dist/server/server.js",
    "preview": "vite preview",
    "route:gen": "tsr generate",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings src",
    "typecheck": "tsr generate && tsgo --noEmit",
    "test": "bun test --timeout 30000 src",
    "clean": "rm -rf .turbo dist .output .vinxi .tsbuildinfo node_modules/.vite src/routeTree.gen.ts"
  },
  "dependencies": {
    "@dalp-examples/dalp-client": "workspace:*",
    "@dalp-examples/theme": "workspace:*",
    "@tanstack/react-query": "5.100.10",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-router-ssr-query": "1.166.12",
    "@tanstack/react-start": "1.167.65",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@dalp-examples/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/router-cli": "1.166.43",
    "@tanstack/router-plugin": "1.166.12",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "6.0.11"
  }
}
