{
  "name": "@settlemint/dalp-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend examples for the SettleMint Digital Asset Lifecycle Platform (DALP)",
  "homepage": "https://github.com/settlemint/dalp-examples",
  "bugs": {
    "url": "https://github.com/settlemint/dalp-examples/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "SettleMint",
    "email": "support@settlemint.com",
    "url": "https://settlemint.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/settlemint/dalp-examples.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && oxlint -c .oxlintrc.json --deny-warnings .",
    "lint:fix": "oxlint -c .oxlintrc.json --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "commitlint": "commitlint --from=origin/main --to=HEAD",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.1",
    "@changesets/cli": "2.27.11",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@typescript/native-preview": "7.0.0-dev.20260514.1",
    "husky": "9.1.7",
    "nano-staged": "1.0.2",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0",
    "turbo": "2.9.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "oxc-resolver",
    "oxfmt",
    "oxlint",
    "unrs-resolver"
  ]
}
