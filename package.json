{
  "name": "dalp-examples",
  "version": "0.0.1",
  "private": true,
  "description": "Forkable DALP reference apps + LLM-consumable SDK Skill",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "lefthook": "^1.7.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20"
  },
  "packageManager": "bun@1.1.0"
}
